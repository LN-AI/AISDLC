# ── Required ──────────────────────────────────────────────────────────────
# Get your API key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# ── Optional: GitHub PR Review integration ────────────────────────────────
# Create a fine-grained PAT with 'Pull requests: Read and Write' permission
GITHUB_TOKEN=ghp_...

# ── Optional: App configuration ───────────────────────────────────────────
# Path for SQLite database file
DATABASE_PATH=sdlc_agent.db

# Claude model to use
CLAUDE_MODEL=claude-sonnet-4-6

# Max tokens for agent responses
MAX_TOKENS=4096

# App environment
APP_ENV=development

# Secret key (change in production)
SECRET_KEY=change-this-to-a-random-32-char-secret
