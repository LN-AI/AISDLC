# ── Required ──────────────────────────────────────────────────────────────
# Get your API key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# ── Optional: GitHub PR Review integration ────────────────────────────────
# Create a fine-grained PAT with 'Pull requests: Read and Write' permission
GITHUB_TOKEN=ghp_...

# ── Optional: App configuration ───────────────────────────────────────────
# Path for SQLite database file
DATABASE_PATH=sdlc_agent.db

# Claude model to use
CLAUDE_MODEL=claude-sonnet-4-6

# Max tokens for agent responses
MAX_TOKENS=4096

# App environment
APP_ENV=development

# Secret key (change in production)
SECRET_KEY=change-this-to-a-random-32-char-secret

# ── Optional: governance ──────────────────────────────────────────────────
# Require credentials on the legacy /api/review/* endpoints the SPA uses. These once
# accepted callers with no credentials at all and treated them as unrestricted, which
# is a way around every limit below — so this now defaults to true.
# The SPA always sends its token, so a signed-in user is unaffected; what stops working
# is *anonymous* browser use (dismissing the login modal and running agents anyway).
LEGACY_ROUTES_REQUIRE_AUTH=true

# Limits (plans, budgets, quotas) attach to a project. An API key carries its project;
# a browser session sends whichever project the user picked in the header dropdown.
# A signed-in user who hasn't picked one has no plan and no budget — i.e. unrestricted,
# fine for an internal console, a hole once customers get logins. Set this to true to
# refuse agent calls that aren't bound to a project.
UI_REQUIRE_PROJECT=false
