{
  "name": "LM AI-SDLC — Jira Requirement Gate",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "lm-sdlc-jira-gate",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "webhook-jira",
      "name": "Jira Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "values": {
          "string": [
            { "name": "lm_sdlc_base_url", "value": "https://your-lm-sdlc-host.example.com" },
            { "name": "lm_sdlc_api_key", "value": "lmsdlc_REPLACE_WITH_YOUR_KEY" },
            { "name": "jira_base_url", "value": "https://your-domain.atlassian.net" }
          ]
        },
        "options": {}
      },
      "id": "set-config",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [460, 300]
    },
    {
      "parameters": {
        "url": "={{ $node[\"Config\"].json[\"lm_sdlc_base_url\"] }}/api/v1/agents/requirement",
        "authentication": "none",
        "method": "POST",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-API-Key", "value": "={{ $node[\"Config\"].json[\"lm_sdlc_api_key\"] }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ jira_ticket: $json.body.issue.key, project_name: $json.body.issue.fields.project.name }) }}",
        "options": {}
      },
      "id": "http-requirement-review",
      "name": "Requirement Review",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [680, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.gate_status }}",
              "operation": "notEqual",
              "value2": "Green"
            }
          ]
        }
      },
      "id": "if-gate-not-green",
      "name": "Gate Not Green?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [900, 300]
    },
    {
      "parameters": {
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "url": "={{ $node[\"Config\"].json[\"jira_base_url\"] }}/rest/api/3/issue/{{ $node[\"Jira Webhook\"].json.body.issue.key }}/comment",
        "method": "POST",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "Content-Type", "value": "application/json" }]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ body: { type: 'doc', version: 1, content: [{ type: 'paragraph', content: [{ type: 'text', text: 'LM AI-SDLC Requirement Review — Gate: ' + $json.gate_status + ' | Risk: ' + $json.risk_score + '/100\\n' + $json.summary }] }] } }) }}",
        "options": {}
      },
      "id": "http-jira-comment",
      "name": "Comment on Jira Issue",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [1120, 220],
      "credentials": {
        "httpBasicAuth": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID",
          "name": "Jira Basic Auth (email + API token)"
        }
      }
    }
  ],
  "connections": {
    "Jira Webhook": {
      "main": [[{ "node": "Config", "type": "main", "index": 0 }]]
    },
    "Config": {
      "main": [[{ "node": "Requirement Review", "type": "main", "index": 0 }]]
    },
    "Requirement Review": {
      "main": [[{ "node": "Gate Not Green?", "type": "main", "index": 0 }]]
    },
    "Gate Not Green?": {
      "main": [
        [{ "node": "Comment on Jira Issue", "type": "main", "index": 0 }],
        []
      ]
    }
  },
  "pinData": {},
  "meta": {
    "templateCredsSetupCompleted": false,
    "description": "LM AI-SDLC Jira Requirement Gate — reviews a ticket's requirement text whenever your Jira automation calls this webhook, and comments back on the ticket when the gate isn't Green. Requires an HTTP Basic Auth credential (Jira email + API token) assigned to the 'Comment on Jira Issue' node."
  }
}
