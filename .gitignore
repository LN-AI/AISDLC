# Secrets / environment
.env
*.env.local

# Personal Claude Code preferences
CLAUDE.local.md

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/

# Databases. `-wal`/`-shm` are the WAL-mode siblings this repo's own PRAGMA creates;
# the list predated WAL and covered only the rollback journal.
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Logs
*.log

# Demo capture output (PNGs, contact sheet, artifact page) — all regenerable via
# scripts/demo_capture.py, demo_contact_sheet.py, demo_artifact.py
demo/screenshots/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Node (if any tooling is ever added)
node_modules/

# Local run output. Every one of these is produced by driving a real conversion — build and
# driver logs, a captured parity corpus, a run id, a scratch key. Regenerable, sometimes large,
# and a recording carries a customer's own pages, so none of it belongs in history.
.parity_key
run_id.txt
build.out
drive.out
drive-full.out
cps.json
parity-tools.json
parity-results.json
local_*_testing.py
.commandcode/
# Conversion and UI-examination output directories: screenshots, converted trees and
# run logs from driving the real thing. 36MB of it accumulated untracked, which is one
# `git add -A` away from being in history for ever.
out-*/
